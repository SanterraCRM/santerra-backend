generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "erp_externo"]
}

view resellersView {
  companyId        Int?      @map("cd_emp")
  id               Int?      @unique @map("cd_clien")
  isActive         Int?      @map("ativo")
  name             String?   @map("nome")
  fantasyName      String?   @map("nome_res")
  legalType        String?   @map("tp_pes_desc")
  document         String?   @map("cgc_cpf")
  registrationType String?   @map("tp_insc_desc")
  registration     String?   @map("inscricao")
  activity         String?   @map("ramo")
  creditStatus     String?   @map("st_cred_desc")
  clientGroupCode  String?   @map("cd_grupocli")
  clientGroup      String?   @map("grupo_cliente")
  sellerCode       String?   @map("cd_vend")
  areaCode         String?   @map("cd_area")
  area             String?   @map("area")
  createdAt        DateTime? @map("dt_cad")
  lastBuyDate      DateTime? @map("dt_ult_compra")
  lastBuyValue     Decimal?  @map("vl_ult_compra")
  creditLimitValue Decimal?  @map("vl_lim_cred")
  orderType        String?   @map("tipo_pedido")
  route            String?   @map("rota")
  email            String?   @map("e_mail")
  affiliation      String?   @map("coligacao")
  cnae             String?   @map("cnae")
  foundationDate   DateTime? @map("DtFundacao")
  contactName      String?   @map("nome_contato")
  contactPosition  String?   @map("cargo_contato")
  contactEmail     String?   @map("email_contato")
  contactDDD       String?   @map("ddd_contato")
  contactPhone     String?   @map("fone_contato")
  clientPhoneDDD   String?   @map("tel_cli_ddd")
  clientPhone      String?   @map("tel_cli_numero")
  address          String?   @map("endereco")
  neighborhood     String?   @map("bairro")
  city             String?   @map("municipio")
  cep              String?   @map("cep")
  state            String?   @map("estado")
  street           String?   @map("logradouro")
  number           String?   @map("numero")
  complement       String?   @map("complemento")

  @@map("mat_base_clientes")
  @@schema("erp_externo")
}

view cropsView {
  productId        Int?    @map("cd_prod")
  description      String? @map("descricao")
  activeIngredient String? @map("principio_ativo")
  crop             String? @map("cultura_atendida")

  @@unique([productId, crop])
  @@map("mat_base_culturas")
  @@schema("erp_externo")
}

view productsView {
  id               Int?     @unique @map("cd_prod")
  product          String?  @map("produto")
  isActive         Int?     @map("ativo")
  manufacturerId   String?  @map("cd_fabric")
  manufacturer     String?  @map("fabricante")
  department       String?  @map("departamento")
  section          String?  @map("secao")
  category         String?  @map("categoria")
  line             String?  @map("linha")
  stockUnity       String?  @map("unid_est")
  purchaseUnity    String?  @map("unid_cmp")
  purchaseQuantity Int?     @map("qtde_unid_cmp")
  weight           Decimal? @map("peso_brt")
  weightNet        Decimal? @map("peso_liq")
  volume           Decimal? @map("volume")
  ncm              String?  @map("cd_prod_ncm")

  @@map("mat_base_produtos")
  @@schema("erp_externo")
}

enum CommercialTripStatus {
  PENDING     @map("pendente")
  IN_PROGRESS @map("em_andamento")
  COMPLETED   @map("finalizado")

  @@schema("public")
}

model Company {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  logo        String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  userCompanies UserCompany[]
  invitations   Invitation[]
  roles         Role[]
  persons       Person[]
  employees     Employee[]
  producers     Producer[]
  potentials    Potential[]
  resellers     Reseller[]
  events        Event[]
  actions       CommercialAction[]
  trips         CommercialTrip[]
  files         File[]
  products      Product[]
  groups        Group[]

  createdBy User? @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("CompanyDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
  @@schema("public")
}

model Person {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  nationalId  String?
  phoneNumber String?
  email       String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
  producers Producer[]

  createdBy User? @relation("PersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PersonUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("PersonDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String
  passwordHash    String
  isPlatformAdmin Boolean   @default(false)
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  deletedById     String?   @db.Uuid

  companyMemberships UserCompany[]   @relation("UserMemberships")
  passwordResets     PasswordReset[]

  createdMemberships UserCompany[] @relation("UserCompanyCreatedBy")
  updatedMemberships UserCompany[] @relation("UserCompanyUpdatedBy")
  deletedMemberships UserCompany[] @relation("UserCompanyDeletedBy")

  createdCompanies Company[] @relation("CompanyCreatedBy")
  updatedCompanies Company[] @relation("CompanyUpdatedBy")
  deletedCompanies Company[] @relation("CompanyDeletedBy")

  createdPeople Person[] @relation("PersonCreatedBy")
  updatedPeople Person[] @relation("PersonUpdatedBy")
  deletedPeople Person[] @relation("PersonDeletedBy")

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  deletedUsers User[] @relation("UserDeletedBy")

  createdWallets         Wallet[]         @relation("WalletCreatedBy")
  updatedWallets         Wallet[]         @relation("WalletUpdatedBy")
  deletedWallets         Wallet[]         @relation("WalletDeletedBy")
  createdWalletMovements WalletMovement[] @relation("WalletMovementCreatedBy")

  createdRoles Role[] @relation("RoleCreatedBy")
  updatedRoles Role[] @relation("RoleUpdatedBy")
  deletedRoles Role[] @relation("RoleDeletedBy")

  createdInvitations Invitation[] @relation("InvitationCreatedBy")
  updatedInvitations Invitation[] @relation("InvitationUpdatedBy")
  deletedInvitations Invitation[] @relation("InvitationDeletedBy")

  createdEmployees Employee[] @relation("EmployeeCreatedBy")
  updatedEmployees Employee[] @relation("EmployeeUpdatedBy")
  deletedEmployees Employee[] @relation("EmployeeDeletedBy")

  createdProducers Producer[] @relation("ProducerCreatedBy")
  updatedProducers Producer[] @relation("ProducerUpdatedBy")
  deletedProducers Producer[] @relation("ProducerDeletedBy")

  createdPotentials Potential[] @relation("PotentialCreatedBy")
  updatedPotentials Potential[] @relation("PotentialUpdatedBy")
  deletedPotentials Potential[] @relation("PotentialDeletedBy")

  createdResellers Reseller[] @relation("ResellerCreatedBy")
  updatedResellers Reseller[] @relation("ResellerUpdatedBy")
  deletedResellers Reseller[] @relation("ResellerDeletedBy")

  createdEvents Event[] @relation("EventCreatedBy")
  updatedEvents Event[] @relation("EventUpdatedBy")
  deletedEvents Event[] @relation("EventDeletedBy")

  createdCommercialActions CommercialAction[] @relation("CommercialActionCreatedBy")
  updatedCommercialActions CommercialAction[] @relation("CommercialActionUpdatedBy")
  deletedCommercialActions CommercialAction[] @relation("CommercialActionDeletedBy")

  createdCommercialTrips CommercialTrip[] @relation("CommercialTripCreatedBy")
  updatedCommercialTrips CommercialTrip[] @relation("CommercialTripUpdatedBy")
  deletedCommercialTrips CommercialTrip[] @relation("CommercialTripDeletedBy")

  createdHarvests Harvest[] @relation("HarvestCreatedBy")
  updatedHarvests Harvest[] @relation("HarvestUpdatedBy")
  deletedHarvests Harvest[] @relation("HarvestDeletedBy")

  createdManufacturers Manufacturer[] @relation("ManufacturerCreatedBy")
  updatedManufacturers Manufacturer[] @relation("ManufacturerUpdatedBy")
  deletedManufacturers Manufacturer[] @relation("ManufacturerDeletedBy")

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")
  deletedProducts Product[] @relation("ProductDeletedBy")

  createdGroups Group[] @relation("GroupCreatedBy")
  updatedGroups Group[] @relation("GroupUpdatedBy")
  deletedGroups Group[] @relation("GroupDeletedBy")

  createdFiles File[] @relation("FileCreatedBy")
  updatedFiles File[] @relation("FileUpdatedBy")
  deletedFiles File[] @relation("FileDeletedBy")

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("UserDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
  @@schema("public")
}

model UserCompany {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  companyId   String    @db.Uuid
  isOwner     Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  user    User    @relation("UserMemberships", fields: [userId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  employee  Employee?
  wallets   Wallet[]
  userRoles UserRole[]

  createdBy User? @relation("UserCompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("UserCompanyUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("UserCompanyDeletedBy", fields: [deletedById], references: [id])

  @@unique([userId, companyId])
  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model Wallet {
  id            String    @id @default(uuid()) @db.Uuid
  value         Decimal   @default(0) @db.Decimal(14, 2)
  userCompanyId String    @db.Uuid
  companyId     String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  userCompany UserCompany @relation(fields: [userCompanyId, companyId], references: [id, companyId], onDelete: Restrict)

  commercialActions CommercialAction[]
  movements         WalletMovement[]

  createdBy User? @relation("WalletCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("WalletUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("WalletDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([userCompanyId, deletedAt])
  @@schema("public")
}

enum WalletMovementType {
  INITIAL_BALANCE @map("saldo_inicial")
  ADJUSTMENT      @map("ajuste")
  ACTION_DEBIT    @map("debito_acao")
  ACTION_REFUND   @map("estorno_acao")

  @@schema("public")
}

model WalletMovement {
  id                 String             @id @default(uuid()) @db.Uuid
  sequence           Int                @default(autoincrement())
  walletId           String             @db.Uuid
  companyId          String             @db.Uuid
  type               WalletMovementType
  amount             Decimal            @db.Decimal(14, 2)
  balanceAfter       Decimal            @db.Decimal(14, 2)
  reason             String?
  commercialActionId String?            @db.Uuid
  createdAt          DateTime           @default(now())
  createdById        String?            @db.Uuid

  wallet           Wallet            @relation(fields: [walletId, companyId], references: [id, companyId], onDelete: Restrict)
  commercialAction CommercialAction? @relation(fields: [commercialActionId, companyId], references: [id, companyId], onDelete: Restrict)

  createdBy User? @relation("WalletMovementCreatedBy", fields: [createdById], references: [id])

  @@index([walletId, sequence])
  @@index([commercialActionId])
  @@schema("public")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company     Company          @relation(fields: [companyId], references: [id])
  userRoles   UserRole[]
  permissions RolePermission[]
  invitations InvitationRole[]

  createdBy User? @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoleDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  roles RolePermission[]

  @@schema("public")
}

model UserRole {
  roleId        String @db.Uuid
  userCompanyId String @db.Uuid
  companyId     String @db.Uuid

  role        Role        @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Restrict)
  userCompany UserCompany @relation(fields: [userCompanyId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([roleId, userCompanyId])
  @@index([userCompanyId])
  @@schema("public")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@schema("public")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company Company          @relation(fields: [companyId], references: [id])
  roles   InvitationRole[]

  createdBy User? @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("InvitationUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("InvitationDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("public")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  tokenHash  String?   @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@schema("public")
}

model InvitationRole {
  invitationId String @db.Uuid
  roleId       String @db.Uuid
  companyId    String @db.Uuid

  invitation Invitation @relation(fields: [invitationId, companyId], references: [id, companyId], onDelete: Restrict)
  role       Role       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@schema("public")
}

model Employee {
  id            String    @id @default(uuid()) @db.Uuid
  personId      String    @db.Uuid
  userCompanyId String?   @db.Uuid
  hiredAt       DateTime?
  terminatedAt  DateTime?
  companyId     String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  person             Person                        @relation(fields: [personId, companyId], references: [id, companyId])
  company            Company                       @relation(fields: [companyId], references: [id])
  userCompany        UserCompany?                  @relation(fields: [userCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  commercialActions  CommercialAction[]            @relation("CommercialActionResponsible")
  commercialTrips    CommercialTrip[]              @relation("CommercialTripResponsible")
  actionParticipants CommercialActionParticipant[]
  tripParticipants   CommercialTripParticipant[]

  createdBy User? @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("EmployeeDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@unique([userCompanyId, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model Potential {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  numericValue Decimal?  @db.Decimal(12, 2)
  description  String?
  companyId    String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedById  String?   @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id])
  producers Producer[]

  createdBy User? @relation("PotentialCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PotentialUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("PotentialDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model Producer {
  id          String    @id @default(uuid()) @db.Uuid
  personId    String    @db.Uuid
  potentialId String    @db.Uuid
  address     String?
  mainCrop    String?
  totalArea   Decimal?  @db.Decimal(12, 2)
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  person    Person    @relation(fields: [personId, companyId], references: [id, companyId])
  potential Potential @relation(fields: [potentialId, companyId], references: [id, companyId])
  company   Company   @relation(fields: [companyId], references: [id])

  commercialActionGuests CommercialActionProducerGuest[]
  commercialTrips        CommercialTrip[]

  createdBy User? @relation("ProducerCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ProducerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ProducerDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@index([potentialId])
  @@schema("public")
}

model Reseller {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String?
  phoneNumber        String?
  email              String?
  companyId          String    @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedById        String?   @db.Uuid

  company Company @relation(fields: [companyId], references: [id])


  createdBy User? @relation("ResellerCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ResellerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ResellerDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company Company            @relation(fields: [companyId], references: [id])
  actions CommercialAction[]

  createdBy User? @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("EventDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model CommercialAction {
  id            String    @id @default(uuid()) @db.Uuid
  description   String?
  eventId       String    @db.Uuid
  price         Decimal?  @db.Decimal(14, 2)
  initialDate   DateTime?
  finalDate     DateTime?
  walletId      String    @db.Uuid
  responsibleId String    @db.Uuid
  companyId     String    @db.Uuid
  invoiceNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  event       Event    @relation(fields: [eventId, companyId], references: [id, companyId])
  wallet      Wallet   @relation(fields: [walletId, companyId], references: [id, companyId])
  responsible Employee @relation("CommercialActionResponsible", fields: [responsibleId, companyId], references: [id, companyId])
  company     Company  @relation(fields: [companyId], references: [id])

  producerGuests CommercialActionProducerGuest[]
  resellerGuests CommercialActionResellerGuest[]
  participants   CommercialActionParticipant[]
  files          FileCommercialAction[]

  walletMovements WalletMovement[]

  createdBy User? @relation("CommercialActionCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CommercialActionUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("CommercialActionDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model CommercialActionProducerGuest {
  id                 String @id @default(uuid()) @db.Uuid
  commercialActionId String @db.Uuid
  producerId         String @db.Uuid
  companyId          String @db.Uuid

  commercialAction CommercialAction @relation(fields: [commercialActionId, companyId], references: [id, companyId])
  producer         Producer         @relation(fields: [producerId, companyId], references: [id, companyId])

  @@unique([commercialActionId, producerId])
  @@index([producerId])
  @@schema("public")
}

model CommercialActionResellerGuest {
  id                 String @id @default(uuid()) @db.Uuid
  commercialActionId String @db.Uuid
  resellerId         Int
  companyId          String @db.Uuid

  commercialAction CommercialAction @relation(fields: [commercialActionId, companyId], references: [id, companyId])

  @@unique([commercialActionId, resellerId])
  @@index([resellerId])
  @@schema("public")
}

model CommercialActionParticipant {
  id                 String @id @default(uuid()) @db.Uuid
  employeeId         String @db.Uuid
  commercialActionId String @db.Uuid
  companyId          String @db.Uuid

  employee         Employee         @relation(fields: [employeeId, companyId], references: [id, companyId])
  commercialAction CommercialAction @relation(fields: [commercialActionId, companyId], references: [id, companyId])

  @@unique([employeeId, commercialActionId])
  @@schema("public")
}

model CommercialTrip {
  id                         String               @id @default(uuid()) @db.Uuid
  performedActionDescription String?
  followUpDetails            String?
  pendingIssuesDescription   String?
  status                     CommercialTripStatus @default(PENDING)
  tripDate                   DateTime?
  expectedDate               DateTime?
  producerId                 String               @db.Uuid
  responsibleId              String               @db.Uuid
  companyId                  String               @db.Uuid
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  deletedAt                  DateTime?
  createdById                String?              @db.Uuid
  updatedById                String?              @db.Uuid
  deletedById                String?              @db.Uuid

  producer    Producer @relation(fields: [producerId, companyId], references: [id, companyId])
  responsible Employee @relation("CommercialTripResponsible", fields: [responsibleId, companyId], references: [id, companyId])
  company     Company  @relation(fields: [companyId], references: [id])

  participants    CommercialTripParticipant[]
  harvests        CommercialTripHarvest[]
  recommendations ProductRecommendation[]
  files           FileCommercialTrip[]

  createdBy User? @relation("CommercialTripCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CommercialTripUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("CommercialTripDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model CommercialTripParticipant {
  id               String @id @default(uuid()) @db.Uuid
  employeeId       String @db.Uuid
  commercialTripId String @db.Uuid
  companyId        String @db.Uuid

  employee       Employee       @relation(fields: [employeeId, companyId], references: [id, companyId])
  commercialTrip CommercialTrip @relation(fields: [commercialTripId, companyId], references: [id, companyId])

  @@unique([employeeId, commercialTripId])
  @@schema("public")
}

model Harvest {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  commercialTrips CommercialTripHarvest[]

  createdBy User? @relation("HarvestCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("HarvestUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("HarvestDeletedBy", fields: [deletedById], references: [id])

  @@schema("public")
}

model CommercialTripHarvest {
  id               String @id @default(uuid()) @db.Uuid
  harvestId        String @db.Uuid
  commercialTripId String @db.Uuid

  harvest        Harvest        @relation(fields: [harvestId], references: [id])
  commercialTrip CommercialTrip @relation(fields: [commercialTripId], references: [id])

  @@unique([harvestId, commercialTripId])
  @@schema("public")
}

model Manufacturer {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String?
  phoneNumber        String?
  email              String?
  passwordHash       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedById        String?   @db.Uuid

  products Product[]

  createdBy User? @relation("ManufacturerCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ManufacturerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ManufacturerDeletedBy", fields: [deletedById], references: [id])

  @@schema("public")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  price          Decimal?  @db.Decimal(14, 2)
  costPrice      Decimal?  @db.Decimal(14, 2)
  manufacturerId String    @db.Uuid
  companyId      String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedById    String?   @db.Uuid

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  company      Company      @relation(fields: [companyId], references: [id])

  groups          ProductGroup[]
  files           FileProduct[]

  createdBy User? @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ProductDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company  Company        @relation(fields: [companyId], references: [id])
  products ProductGroup[]

  createdBy User? @relation("GroupCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("GroupDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model ProductGroup {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  groupId   String @db.Uuid
  companyId String @db.Uuid

  product Product @relation(fields: [productId, companyId], references: [id, companyId])
  group   Group   @relation(fields: [groupId, companyId], references: [id, companyId])

  @@unique([productId, groupId])
  @@schema("public")
}

model ProductRecommendation {
  id               String @id @default(uuid()) @db.Uuid
  commercialTripId String @db.Uuid
  productId        Int
  companyId        String @db.Uuid

  commercialTrip CommercialTrip @relation(fields: [commercialTripId, companyId], references: [id, companyId])

  @@unique([commercialTripId, productId])
  @@schema("public")
}

model File {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  originalName String?
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedById  String?   @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  commercialActions FileCommercialAction[]
  commercialTrips   FileCommercialTrip[]
  products          FileProduct[]

  createdBy User? @relation("FileCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("FileUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("FileDeletedBy", fields: [deletedById], references: [id])

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@schema("public")
}

model FileCommercialAction {
  id                 String @id @default(uuid()) @db.Uuid
  fileId             String @db.Uuid
  commercialActionId String @db.Uuid
  companyId          String @db.Uuid

  file             File             @relation(fields: [fileId, companyId], references: [id, companyId])
  commercialAction CommercialAction @relation(fields: [commercialActionId, companyId], references: [id, companyId])

  @@unique([fileId, commercialActionId])
  @@schema("public")
}

model FileCommercialTrip {
  id               String @id @default(uuid()) @db.Uuid
  fileId           String @db.Uuid
  commercialTripId String @db.Uuid
  companyId        String @db.Uuid

  file           File           @relation(fields: [fileId, companyId], references: [id, companyId])
  commercialTrip CommercialTrip @relation(fields: [commercialTripId, companyId], references: [id, companyId])

  @@unique([fileId, commercialTripId])
  @@schema("public")
}

model FileProduct {
  id        String @id @default(uuid()) @db.Uuid
  fileId    String @db.Uuid
  productId String @db.Uuid
  companyId String @db.Uuid

  file    File    @relation(fields: [fileId, companyId], references: [id, companyId])
  product Product @relation(fields: [productId, companyId], references: [id, companyId])

  @@unique([fileId, productId])
  @@schema("public")
}
